{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "@prb/devkit/biome/base"],
  "root": true,
  "files": {
    "includes": [
      "**/*.{graphql,js,json,jsonc,ts}",
      "**/codegen", // needed because Ultracite disables it
      "!envio/**/bindings",
      "!graph/**/bindings"
    ]
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "off" // TODO: enable later
      },
      "style": {
        "noNestedTernary": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["package.json"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicateDependencies": "off" // `sablier` is both bundled for runtime and declared as a peer for consumers
          }
        }
      }
    },
    /* -------------------------------------------------------------------------- */
    /*                                YAML CODEGEN                                */
    /* -------------------------------------------------------------------------- */
    {
      "includes": [
        "cli/commands/codegen/envio-config/**/*.ts",
        "cli/commands/codegen/graph-manifest/**/*.ts"
      ],
      "assist": { "actions": { "source": { "useSortedKeys": "off" } } }
    },
    /* -------------------------------------------------------------------------- */
    /*                                   GRAPHQL                                  */
    /* -------------------------------------------------------------------------- */
    // Re-enable formatting for envio graphql files (ultracite disables it by default)
    {
      "includes": ["**/*.graphql"],
      "formatter": { "enabled": true },
      "linter": {
        "enabled": true,
        "rules": {
          "style": {
            // We use PascalCase for enum values, not ALL_CAPS
            "useGraphqlNamingConvention": "off"
          }
        }
      }
    },
    /* -------------------------------------------------------------------------- */
    /*                               ASSEMBLYSCRIPT                               */
    /* -------------------------------------------------------------------------- */
    {
      "includes": ["graph/**/*.ts"],
      "linter": {
        "rules": {
          "complexity": { "useOptionalChain": "off" },
          "style": {
            "noNegationElse": "off",
            "noSubstr": "off",
            // The Graph's AssemblyScript 0.19 parser does not support destructuring.
            "useDestructuring": "off",
            "useFilenamingConvention": "off",
            "useForOf": "off",
            "useImportType": "off"
          },
          "suspicious": {
            "noDoubleEquals": "off",
            "noShadowRestrictedNames": "off"
          }
        }
      }
    },
    {
      "includes": [
        "cli/commands/refresh-caches/run.ts",
        "tests/vendors/equivalence/create-test.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            // Queue workers and cursor pagination require each prior result before advancing.
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    /* -------------------------------------------------------------------------- */
    /*                                    TESTS                                   */
    /* -------------------------------------------------------------------------- */
    {
      "includes": ["**/tests/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
