import "../indexer.just"

# Run `just --evaluate ENVIO_HASURA_PUBLIC_AGGREGATE` to see the result
export ENVIO_HASURA_PUBLIC_AGGREGATE := "CryptoFeesDaily&CustomFee&FeeCollection&FeeCollectionDaily&FeeLedger&FeeTransaction&FiatFeesDaily&User&UsersActiveMonthly&UserTransaction"
export ENVIO_INDEXER_NAME := "analytics"
export INDEXER_NAME := "analytics"

# Show available commands
default:
    @just --list

# Dump the effect caches of the running `just envio dev` indexer and keep the fee caches
[script("bash")]
cache-dump:
    set -euo pipefail
    cache_dir="{{ justfile_dir() }}/.envio/cache"
    dumped=$(curl --fail --silent --show-error --request POST "http://localhost:${ENVIO_INDEXER_PORT:-9898}/console/syncCache")
    if [ "$dumped" != "true" ]; then
        echo "❌ The indexer did not dump its effect caches" >&2
        exit 1
    fi
    # The dump rewrites every cache. The price files belong to @sablier/price-data, and recent forex rates can change.
    cd "{{ justfile_dir() }}"
    git ls-files -z -- '.envio/cache/*_USD.tsv' | xargs -0 git checkout --quiet --
    git clean --force --quiet -- '.envio/cache/*_USD.tsv'
    # Sort the rows so that later dumps produce minimal diffs.
    for name in minFeeWei nativeValueReceived; do
        file="$cache_dir/$name.tsv"
        [ -f "$file" ] || continue
        { head -n 1 "$file"; tail -n +2 "$file" | LC_ALL=C sort; } > "$file.tmp"
        mv "$file.tmp" "$file"
    done
    echo "✅ Dumped the fee caches to $cache_dir"

# Rebuild the call-trace cache from the `CallTrace` rows of a hosted deployment
[script("bash")]
cache-export deployment="production":
    set -euo pipefail
    file="{{ justfile_dir() }}/.envio/cache/nativeValueReceived.tsv"
    endpoint=$(just envio::endpoint analytics "{{ deployment }}")
    query='query ($after: String!) { CallTrace(limit: 1000, order_by: [{ id: asc }], where: { id: { _gt: $after } }) { chainId contractAddress hash id value } }'
    rows=$(mktemp)
    trap 'rm -f "$rows"' EXIT
    after=""
    while true; do
        page=$(jq --null-input --arg query "$query" --arg after "$after" '{ query: $query, variables: { after: $after } }' \
            | curl --fail --silent --show-error --header "Content-Type: application/json" --data @- "$endpoint")
        if [ "$(jq 'has("errors")' <<< "$page")" = "true" ]; then
            echo "❌ The deployment rejected the query: $(jq --compact-output '.errors' <<< "$page")" >&2
            exit 1
        fi
        [ "$(jq '.data.CallTrace | length' <<< "$page")" -gt 0 ] || break
        # The row format is the one that Envio writes: the effect input tuple, then the output.
        jq --raw-output '.data.CallTrace[] | "[\(.chainId | tonumber),\(.hash | tojson),\(.contractAddress | tojson)]\t\(.value | tojson)"' <<< "$page" >> "$rows"
        after=$(jq --raw-output '.data.CallTrace[-1].id' <<< "$page")
    done
    if [ ! -s "$rows" ]; then
        echo "❌ The deployment has no CallTrace rows" >&2
        exit 1
    fi
    { printf 'id\toutput\n'; LC_ALL=C sort "$rows"; } > "$file"
    echo "✅ Exported $(wc -l < "$rows" | tr -d ' ') call traces to $file"

# The recipe restarts the indexer after a crash and continues from the stored progress. Run it again to resume.
# Backfill locally until all chains are synced, then dump the fee caches
[script("bash")]
cache-backfill:
    set -uo pipefail
    cd "{{ justfile_dir() }}"
    log="{{ source_dir() }}/../../.logs/analytics-cache-backfill.log"
    mkdir -p "$(dirname "$log")"
    metrics="http://localhost:${ENVIO_INDEXER_PORT:-9898}/metrics"
    stop_indexer() { pkill -TERM -f "envio/bin.mjs dev" || true; }
    trap 'stop_indexer; exit 130' INT TERM
    while true; do
        echo "[$(date '+%F %T')] starting the indexer" >> "$log"
        just envio dev tui_off >> "$log" 2>&1 &
        indexer=$!
        events=""
        idle=0
        while kill -0 "$indexer" 2>/dev/null; do
            sleep 60
            snapshot=$(curl --silent --max-time 10 "$metrics" || true)
            ready=$(grep '^envio_progress_ready' <<< "$snapshot" || true)
            # Rate-limited partitions can starve for hours and block event processing: a restart clears them.
            current=$(awk '/^envio_progress_events/ { sum += $2 } END { print sum + 0 }' <<< "$snapshot")
            if [ "$current" = "$events" ]; then idle=$((idle + 1)); else idle=0; fi
            events=$current
            if [ "$idle" -ge 45 ]; then
                echo "[$(date '+%F %T')] no progress for 45 minutes; restarting the indexer" >> "$log"
                stop_indexer
                idle=0
            fi
            if [ -n "$ready" ] && ! grep -qv ' 1$' <<< "$ready"; then
                echo "[$(date '+%F %T')] all chains are synced" >> "$log"
                just cache-dump >> "$log" 2>&1 && { stop_indexer; echo "✅ Backfill complete; commit the fee caches"; exit 0; }
            fi
        done
        echo "[$(date '+%F %T')] the indexer exited; restarting in 30 seconds" >> "$log"
        sleep 30
    done
