{
  "name": "@sablier/indexers",
  "version": "7.2.0",
  "description": "Data indexers for the Sablier Protocol",
  "homepage": "https://github.com/sablier-labs/indexers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sablier-labs/indexers.git"
  },
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Sablier Labs Ltd",
    "url": "https://sablier.com"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/esm/*.js",
      "default": "./dist/cjs/*.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "typings": "./dist/types/index.d.ts",
  "files": [
    "dist/**",
    "banner.png"
  ],
  "scripts": {
    "prepack": "pnpm install --frozen-lockfile && just build::all",
    "start": "start_indexer() { set -eu; : \"${ENVIO_INDEXER_NAME:?ENVIO_INDEXER_NAME is required}\"; case \"$ENVIO_INDEXER_NAME\" in airdrops|analytics|streams) ;; *) echo \"Invalid ENVIO_INDEXER_NAME: $ENVIO_INDEXER_NAME\" >&2; exit 1 ;; esac; cd \"./envio/$ENVIO_INDEXER_NAME\"; case \"$ENVIO_INDEXER_NAME\" in airdrops|streams) test -s .envio/cache/tokenMetadata.tsv || { echo \"Missing or empty .envio/cache/tokenMetadata.tsv\" >&2; exit 1; } ;; esac; envio start --config config.yaml; }; start_indexer"
  },
  "dependencies": {
    "sablier": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@effect/cli": "^0.75.2",
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.107.0",
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.1.7",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@pinax/graph-networks-registry": "^0.7.1",
    "@prb/devkit": "^1.2.0",
    "@sablier/price-data": "github:sablier-labs/price-data#main",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.5.2",
    "@vitest/ui": "~3",
    "abitype": "^1.2.3",
    "assemblyscript": "^0.28.13",
    "axios": "^1.13.2",
    "axios-retry": "^4.5.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "concurrently": "^9.2.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.1",
    "effect": "^3.21.3",
    "envio": "3.2.1",
    "envio-cloud": "1.0.0",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.6",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "linkifyjs": "^4.3.2",
    "lint-staged": "^16.4.0",
    "lodash-es": "^4.18.1",
    "ora": "^9.3.0",
    "prettier": "^3.8.1",
    "strip-ansi": "^7.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5",
    "ultracite": "^8.1.0",
    "viem": "^2.47.10",
    "vite": "^7.3.2",
    "vitest": "~3"
  },
  "peerDependencies": {
    "sablier": "^4"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
